{
  "rules": {
    "ads": {
      ".read": true,
      ".indexOn": [
        "createdAt",
        "uid",
        "category",
        "status"
      ],
      "$adId": {
        ".write": "auth != null && (auth.token.email === 'nisar733308@gmail.com' || (!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid))"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'nisar733308@gmail.com')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'nisar733308@gmail.com')"
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && (auth.token.email === 'nisar733308@gmail.com' || !data.exists() || data.child('members').child(auth.uid).exists())",
        ".write": "auth != null && (auth.token.email === 'nisar733308@gmail.com' || data.child('members').child(auth.uid).exists() || newData.child('members').child(auth.uid).exists())"
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'nisar733308@gmail.com')",
        ".indexOn": [
          "lastTs"
        ],
        "$chatId": {
          ".write": "auth != null"
        }
      }
    },
    "reports": {
      ".read": "auth != null && auth.token.email === 'nisar733308@gmail.com'",
      ".write": "auth != null && auth.token.email === 'nisar733308@gmail.com'",
      "$adId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}